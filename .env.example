# App environment mode: local, test, or prod (defaults to local)
APP_ENV=local

# Frappe Backend Integration URL
FRAPPE_URL=http://host.docker.internal:8000

# AXON-SERVER orchestrator URL used by the Frappe axon proxy
AXON_SERVER_URL=http://127.0.0.1:8006

# Path to the Axon model files on this machine (used by the Ollama volume mount)
OLLAMA_MODEL_PATH=/path/to/axon_5.6
