          "Module",
          "Description",
          "app_name: <value>"
        ]
      },
      {
        "turn": 2,
        "query": "app_name: fleet_management, priority: High, module: Vehicle Tracking",
        "expected_response_contains": [
          "I just need one more detail to proceed",
          "Description",
          "description: <value>"
        ]
      },
      {
        "turn": 3,
        "query": "The GPS coordinates are lagging and updating only every 5 minutes",
        "expected_response_contains": [
          "Reference ID:",
          "ERP_I_"
        ]
      }
    ]
  },
  {
