[
  {
    "feature": "Lost and Found",
    "scenario": "Report a lost item (Interactive Multi-Turn)",
    "steps": [
      {
        "turn": 1,
        "query": "I lost my item",
        "expected_response_contains": [
          "I'm sorry to hear you've lost your item",
          "Item Name",
          "Lost Location",
          "Lost Description",
          "item_name: <value>"
        ]
      },
      {
        "turn": 2,
        "query": "item_name: Access Card, lost_location: Cafeteria",
        "expected_response_contains": [
          "I just need one more detail to proceed",
          "Lost Description",
          "lost_description: <value>"
        ]
      },
      {
        "turn": 3,
        "query": "It is a blue access card with my employee photo on the front",
        "expected_response_contains": [
          "Reference ID:",
          "LF-"
        ]
      }
    ]
  },
  {
    "feature": "Lost and Found",
    "scenario": "Report a found item (Interactive Multi-Turn)",
    "steps": [
      {
        "turn": 1,
        "query": "I found a lost item",
        "expected_response_contains": [
          "Thank you for reporting this found item",
          "Record Name",
          "Found Location",
          "Found Date",
          "Found Description"
        ]
      },
      {
        "turn": 2,
        "query": "name: LF-27-0526-00010, found_location: Cafeteria desk",
        "expected_response_contains": [
          "Found Date",
          "Found Description"
        ]
      },
      {
        "turn": 3,
        "query": "found_date: today, found_description: Placed it safe at the main counter.",
        "expected_response_contains": [
          "Reference ID:",
          "LF-"
        ]
      }
    ]
  },
  {
    "feature": "ERP Support Ticket",
    "scenario": "Create a Support Ticket (Interactive Multi-Turn)",
    "steps": [
      {
        "turn": 1,
        "query": "I want to raise a support ticket",
        "expected_response_contains": [
          "I'll help you raise a support ticket",
          "Application Name",
